// Grafana Alloy: collects the output of every Onshore container and sends it to Loki.
// It reaches Docker only through docker-socket-proxy, which allows listing
// containers and reading their logs, nothing else.

discovery.docker "onshore" {
  host             = "tcp://docker-socket-proxy:2375"
  refresh_interval = "15s"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT_NAME")]
  }
}

discovery.relabel "onshore" {
  targets = []

  // The socket proxy logs every poll Alloy makes: noise, so it isn't collected.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "docker-socket-proxy"
    action        = "drop"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

loki.source.docker "onshore" {
  host             = "tcp://docker-socket-proxy:2375"
  targets          = discovery.docker.onshore.targets
  relabel_rules    = discovery.relabel.onshore.rules
  refresh_interval = "15s"
  labels           = { install = sys.env("RV_HOST") }
  forward_to       = [loki.process.onshore.receiver]
}

loki.process "onshore" {
  // A level for every line, so errors can be counted across services. The control
  // API writes JSON with a numeric level; Go services write plain text.
  stage.match {
    selector = "{service=\"control-api\"}"
    stage.regex {
      expression = "\"level\":(?P<lvl>\\d+)"
    }
    stage.template {
      source   = "level"
      template = "{{ if .lvl }}{{ if or (eq .lvl \"50\") (eq .lvl \"60\") }}error{{ else if eq .lvl \"40\" }}warn{{ else }}info{{ end }}{{ end }}"
    }
  }
  stage.match {
    selector = "{service!=\"control-api\"}"
    stage.regex {
      expression = "(?i)\\b(?P<word>panic|fatal|error|failed|warn|warning)\\b"
    }
    stage.template {
      source   = "level"
      template = "{{ if .word }}{{ $w := ToLower .word }}{{ if or (eq $w \"warn\") (eq $w \"warning\") }}warn{{ else }}error{{ end }}{{ else }}info{{ end }}"
    }
  }
  stage.labels {
    values = { level = "" }
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
