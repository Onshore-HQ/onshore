generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
  moduleFormat        = "esm"
}
datasource db {
  provider = "postgresql"
}

model Customer {
  id        Int      @id @default(autoincrement())
  ref       String   @unique
  fullName  String
  phone     String
  email     String
  dob       String
  city      String
  bvn       String
  nin       String
  tokenized Boolean  @default(false)
  createdAt DateTime @default(now())
  accounts  Account[]
  transfers Transfer[]
  loans     Loan[]
  chats     ChatMessage[]
}
model Account {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])
  bank       String
  nuban      String
  last4      String
  balance    Int      @default(0)
}
model Transfer {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])
  toBank     String
  toAccount  String
  toName     String
  amount     Int
  narration  String
  status     String
  createdAt  DateTime @default(now())
  @@index([customerId, createdAt])
}
model Loan {
  id         Int      @id @default(autoincrement())
  loanRef    String   @unique
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])
  amount     Int
  tenor      Int
  income     Int
  employer   String
  status     String
  createdAt  DateTime @default(now())
}
model ChatMessage {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])
  role       String
  content    String
  createdAt  DateTime @default(now())
  @@index([customerId, createdAt])
}
model OpsLine {
  id        Int      @id @default(autoincrement())
  level     String
  line      String
  createdAt DateTime @default(now())
}
