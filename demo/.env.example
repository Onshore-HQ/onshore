# Copy to demo/.env. Leave a tool blank and the local stand-in on port 4200 takes its place.
# Use a dedicated demo email for these accounts, never personal ones.

# L1 logs: Grafana Cloud > your stack > OpenTelemetry. Endpoint looks like
# https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
GRAFANA_OTLP_ENDPOINT=
# The "Authorization" value Grafana shows you, starting "Basic ".
GRAFANA_OTLP_AUTH=

# L2 errors: Sentry > Settings > Projects > Client Keys (DSN). Choose the US data region.
SENTRY_DSN=

# L3 AI: any OpenAI-compatible API.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# L4 analytics copy: Neon or Supabase, EU region. The connection string, with sslmode=require.
ANALYTICS_DATABASE_URL=
# Shown on the residency map, and used to match the catalogue: Neon is declared as a custom vendor.
ANALYTICS_HOST=
