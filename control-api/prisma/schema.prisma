generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  previewFeatures     = ["partialIndexes"]
  importFileExtension = "js"
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["control", "events"]
}

model approved_networks {
  id        String   @id
  tenant_id String
  name      String
  cidrs     String[]
  tenants   tenants  @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenant_id, name])
  @@schema("control")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model break_glass_grants {
  id               String     @id
  tenant_id        String
  principal_id     String
  vault_id         String
  reason           String
  requested_by     String
  approved_by      String?
  status           String     @default("pending")
  duration_minutes Int
  expires_at       DateTime?  @db.Timestamptz(6)
  created_at       DateTime   @default(now()) @db.Timestamptz(6)
  principals       principals @relation(fields: [principal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants          tenants    @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vaults           vaults     @relation(fields: [vault_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("control")
}

model column_groups {
  id           String         @id
  vault_id     String
  name         String
  token_kind   String
  token_format String
  vaults       vaults         @relation(fields: [vault_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vault_fields vault_fields[]

  @@unique([vault_id, name])
  @@schema("control")
}

model licences {
  id          String   @id
  tenant_id   String
  signed_blob String
  features    String[] @default([])
  seats       Int?
  expires_at  DateTime @db.Timestamptz(6)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  tenants     tenants  @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("control")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model log_pipelines {
  system_id String?
  upstream_host String?
  id              String   @id
  vault_id        String
  name            String
  source_type     String
  destination     String
  upstream_url    String
  entity_types    String[]
  action_per_type Json     @default("{}")
  sensitive_paths String[] @default([])
  sample_rate     Float    @default(1) @db.Real
  mode            String   @default("shadow")
  failure_mode    String   @default("buffer")
  ingest_key_hash String
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  transfer_basis  String   @default("not_assessed")
  vaults          vaults   @relation(fields: [vault_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([vault_id, name])
  @@schema("control")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model policies {
  id           String    @id
  tenant_id    String
  name         String
  version      Int
  source       Json
  compiled_cel Json?
  status       String    @default("draft")
  created_by   String
  approved_by  String?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  published_at DateTime? @db.Timestamptz(6)
  tenants      tenants   @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenant_id, name], map: "policies_one_active", where: raw("(status = 'active'::text)"))
  @@unique([tenant_id, name, version])
  @@schema("control")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model principals {
  id                   String                 @id
  tenant_id            String
  kind                 String
  display_name         String
  email                String?                @unique
  password_hash        String?
  totp_secret_enc      String?
  totp_last_step       BigInt?
  mfa_enabled          Boolean                @default(false)
  status               String                 @default("active")
  approved_network     String?
  last_active_at       DateTime?              @db.Timestamptz(6)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  must_change_password Boolean                @default(false)
  sessions_valid_after DateTime?              @db.Timestamptz(6)
  totp_pending_enc     String?
  source               String                 @default("local")
  external_id          String?
  account_tokens       account_tokens[]
  recovery_codes       recovery_codes[]
  break_glass_grants   break_glass_grants[]
  tenants              tenants                @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role_assignments     role_assignments[]
  service_account_keys service_account_keys[]

  @@schema("control")
}

model role_assignments {
  role_id      String
  principal_id String
  principals   principals @relation(fields: [principal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roles        roles      @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([role_id, principal_id])
  @@schema("control")
}

model roles {
  id               String             @id
  tenant_id        String
  name             String
  role_assignments role_assignments[]
  tenants          tenants            @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenant_id, name])
  @@schema("control")
}

model scope_definitions {
  id         String   @id
  tenant_id  String
  version    Int
  body       String
  created_by String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  tenants    tenants  @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenant_id, version])
  @@schema("control")
}

model service_account_keys {
  id           String     @id
  principal_id String
  public_key   String
  fingerprint  String
  ip_allowlist String[]   @default([])
  expires_at   DateTime?  @db.Timestamptz(6)
  last_used_at DateTime?  @db.Timestamptz(6)
  revoked_at   DateTime?  @db.Timestamptz(6)
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  principals   principals @relation(fields: [principal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("control")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tenants {
  demo_mode Boolean @default(false)
  map_exception_max_days Int @default(180)
  id                             String                           @id
  name                           String
  plan                           String                           @default("growth")
  deployment                     String                           @default("self_hosted")
  hosting_facility               String?
  hosting_country                String?                           
  created_at                     DateTime                         @default(now()) @db.Timestamptz(6)
  kek_rotation_days              Int?
  audit_retention_days           Int                              @default(2557)
  siem_url                       String?
  siem_secret_enc                String?
  siem_cursor                    BigInt                           @default(0)
  metrics_key_hash               String?                          @unique(map: "tenants_metrics_key", where: raw("(metrics_key_hash IS NOT NULL)"))
  approved_networks              approved_networks[]
  break_glass_grants             break_glass_grants[]
  custom_entities                custom_entities[]
  custom_entity_publish_requests custom_entity_publish_requests[]
  licences                       licences[]
  policies                       policies[]
  principals                     principals[]
  protected_pages                protected_pages[]
  roles                          roles[]
  scope_definitions              scope_definitions[]
  sso_configs                    sso_configs?
  vaults                         vaults[]
  webhook_endpoints              webhook_endpoints[]

  home_country                   String?
  sector                         String?
  console_language               String                           @default("en")
  console_format                 String?
  laws                           String[]                         @default([])
  markets                        String[]                         @default([])
  planned_countries              String[]                         @default([])
  setup_completed_at             DateTime?                        @db.Timestamptz(6)
  time_zone                      String                           @default("UTC")
  linked_installs                linked_installs[]
  region_waitlist                region_waitlist[]
  @@schema("control")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model vault_fields {
  id               String           @id
  vault_id         String
  name             String
  data_type        String
  token_kind       String           @default("deterministic")
  token_format     String           @default("opaque")
  column_group_id  String?
  ttl_days         Int?
  ttl_seconds      Int?
  searchable       Boolean          @default(true)
  unique_values    Boolean          @default(false)
  mask_rule        String           @default("default")
  in_payment_scope Boolean          @default(true)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  custom_entity_id String?
  column_groups    column_groups?   @relation(fields: [column_group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  custom_entities  custom_entities? @relation(fields: [custom_entity_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vaults           vaults           @relation(fields: [vault_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([vault_id, name])
  @@schema("control")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model vaults {
  residency_map_enabled Boolean @default(false)
  id                             String                           @id
  tenant_id                      String
  name                           String
  environment                    String
  status                         String                           @default("active")
  created_at                     DateTime                         @default(now()) @db.Timestamptz(6)
  custom_entities_enabled        Boolean                          @default(false)
  detection_thresholds           Json                             @default("{}")
  embed_origins                  String[]                         @default([])
  adapters                       adapters[]
  ai_routes                      ai_routes[]
  cloak_profiles                 cloak_profiles[]
  break_glass_grants             break_glass_grants[]
  column_groups                  column_groups[]
  custom_entities                custom_entities[]
  custom_entity_publish_requests custom_entity_publish_requests[]
  log_pipelines                  log_pipelines[]
  proxy_routes                   proxy_routes[]
  ruleset_versions               ruleset_versions?
  vault_fields                   vault_fields[]
  tenants                        tenants                          @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenant_id, name])
  country                        String
  packs                          String[]                         @default(["everywhere"])
  time_zone                      String?
  @@schema("control")
}

model alerts {
  id              String    @id @db.Uuid
  tenant_id       String
  kind            String
  principal_id    String?
  detail          Json
  event_at        DateTime  @db.Timestamptz(6)
  raised_at       DateTime  @default(now()) @db.Timestamptz(6)
  acknowledged_at DateTime? @db.Timestamptz(6)

  @@index([tenant_id, raised_at(sort: Desc)], map: "alerts_tenant")
  emailed_at DateTime? @db.Timestamptz(6)
  @@schema("events")
}

model audit_checkpoints {
  tenant_id  String
  day        DateTime @db.Date
  seq        BigInt
  hash       String
  signature  String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@id([tenant_id, day])
  @@schema("events")
}

model audit_events {
  seq            BigInt   @id @default(autoincrement())
  event_id       String   @unique @db.Uuid
  occurred_at    DateTime @db.Timestamptz(6)
  tenant_id      String
  vault_id       String?
  principal_id   String?
  principal_kind String?
  source_ip      String?
  geo_country    String?
  network        String?
  module         String
  action         String
  field_id       String?
  record_id      String?  @db.Uuid
  token_hash     String?
  purpose        String?
  decision       String?
  policy_id      String?
  policy_version Int?
  break_glass    Boolean  @default(false)
  request_id     String?
  latency_ms     Int?
  detail         String?
  prev_hash      String
  hash           String

  @@index([principal_id, occurred_at(sort: Desc)], map: "audit_principal")
  @@index([record_id], map: "audit_record")
  @@index([tenant_id, seq], map: "audit_tenant_seq")
  @@index([tenant_id, occurred_at(sort: Desc)], map: "audit_tenant_time")
  @@schema("events")
}

model audit_heads {
  tenant_id String @id
  head_hash String
  head_seq  BigInt @default(0)

  @@schema("events")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model detection_events {
  dest_host String?
  flow_id String?
  occurred_at     DateTime @db.Timestamptz(6)
  vault_id        String
  module          String
  source_id       String
  destination     String   @default("")
  entity_type     String
  action          String
  count           BigInt
  entity_version  Int?
  ruleset_version BigInt?

  @@ignore
  @@schema("events")
}

model usage_daily {
  vault_id           String
  date               DateTime @db.Date
  tokenize_count     BigInt   @default(0)
  detokenize_count   BigInt   @default(0)
  denied_count       BigInt   @default(0)
  detections_by_type Json     @default("{}")
  p95_latency_ms     Int?

  @@id([vault_id, date])
  @@schema("events")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ai_routes {
  system_id String?
  id                  String   @id
  vault_id            String
  name                String
  upstream_base_url   String
  provider            String
  allowed_models      String[] @default([])
  entity_types        String[] @default([])
  restore_in_response Boolean  @default(false)
  mode                String   @default("shadow")
  transfer_basis      String   @default("not_assessed")
  route_key_hash      String
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  cloak_profile_id    String?
  twin_days           Int      @default(0)
  cloak_options       Json     @default("{}")
  vaults              vaults   @relation(fields: [vault_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cloak_profiles      cloak_profiles? @relation(fields: [cloak_profile_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([vault_id, name])
  @@schema("control")
}

model cloak_profiles {
  id         String      @id
  vault_id   String
  name       String
  options    Json        @default("{}")
  created_by String
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  updated_at DateTime    @default(now()) @db.Timestamptz(6)
  vaults     vaults      @relation(fields: [vault_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ai_routes  ai_routes[]

  @@unique([vault_id, name])
  @@schema("control")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model proxy_routes {
  system_id String?
  id                        String   @id
  vault_id                  String
  name                      String
  direction                 String   @default("inbound")
  method                    String
  path_pattern              String
  upstream_url              String
  mode                      String   @default("process_and_store")
  redact_paths              Json     @default("[]")
  unredact_paths            Json     @default("[]")
  response_redact_paths     Json     @default("[]")
  response_unredact_paths   Json     @default("[]")
  redact_query              Json     @default("[]")
  dlp                       Boolean  @default(true)
  dlp_excluded_paths        String[] @default([])
  transfer_basis            String   @default("not_assessed")
  route_key_hash            String
  created_at                DateTime @default(now()) @db.Timestamptz(6)
  redact_headers            Json     @default("[]")
  unredact_headers          Json     @default("[]")
  response_redact_headers   Json     @default("[]")
  response_unredact_headers Json     @default("[]")
  dlp_excluded_headers      String[] @default([])
  dlp_excluded_params       String[] @default([])
  file_policy               String   @default("refuse")
  vaults                    vaults   @relation(fields: [vault_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([vault_id, name])
  @@schema("control")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model adapters {
  id                  String   @id
  vault_id            String
  name                String
  kind                String
  base_url            String
  api_credential_enc  String
  webhook_secret_hash String
  webhook_secret_enc  String
  mode                String   @default("shadow")
  transfer_basis      String   @default("not_assessed")
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  vaults              vaults   @relation(fields: [vault_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([vault_id, name])
  @@schema("control")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sso_configs {
  tenant_id         String   @id
  kind              String
  email_domains     String[]
  issuer            String?
  client_id         String?
  client_secret_enc String?
  idp_sso_url       String?
  idp_cert          String?
  sp_entity_id      String?
  idp_enforces_mfa  Boolean  @default(false)
  sso_only          Boolean  @default(false)
  jit_provisioning  Boolean  @default(false)
  groups_attribute  String?
  scopes            String   @default("openid email profile")
  provider          String?
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  tenants           tenants  @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("control")
}

model sso_states {
  state_hash String   @id
  tenant_id  String
  nonce      String
  verifier   String
  expires_at DateTime @db.Timestamptz(6)

  @@schema("control")
}

model audit_anchors {
  tenant_id      String   @id
  seq            BigInt
  hash           String
  events_removed BigInt   @default(0)
  purged_at      DateTime @default(now()) @db.Timestamptz(6)

  @@schema("events")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model custom_entities {
  id                             String                          @id
  pack_id                        String?
  pack_version                   Int?
  tenant_id                      String
  vault_id                       String
  name                           String
  slug                           String
  kind                           String
  definition                     Json
  validator                      Json?
  context_positive               String[]                        @default([])
  context_negative               String[]                        @default([])
  threshold                      Decimal                         @default(0.70) @db.Decimal(3, 2)
  token_kind                     String                          @default("deterministic")
  token_format                   String                          @default("opaque")
  mask_rule                      Json                            @default("{\"n\": 4, \"type\": \"last_n\"}")
  actions                        Json
  status                         String                          @default("draft")
  version                        Int                             @default(0)
  draft                          Json?
  list_version                   Int                             @default(0)
  staged_list_version            Int?
  created_by                     String
  approved_by                    String?
  edited_by                      String
  published_at                   DateTime?                       @db.Timestamptz(6)
  created_at                     DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime                        @default(now()) @db.Timestamptz(6)
  tenants                        tenants                         @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vaults                         vaults                          @relation(fields: [vault_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  custom_entity_lists            custom_entity_lists[]
  custom_entity_publish_requests custom_entity_publish_requests?
  custom_entity_tests            custom_entity_tests[]
  custom_entity_uploads          custom_entity_uploads[]
  custom_entity_values           custom_entity_values[]
  custom_entity_versions         custom_entity_versions[]
  vault_fields                   vault_fields[]

  @@unique([vault_id, slug])
  @@index([vault_id, status], map: "custom_entities_vault")
  @@schema("control")
}

model custom_entity_lists {
  entity_id       String
  list_version    Int
  value_count     Int
  max_words       Int
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  custom_entities custom_entities @relation(fields: [entity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([entity_id, list_version])
  @@schema("control")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model custom_entity_publish_requests {
  id              String          @id
  tenant_id       String
  vault_id        String
  entity_id       String          @unique(map: "custom_entity_one_pending", where: raw("(status = 'pending'::text)"))
  version         Int
  snapshot        Json
  benchmark       Json
  status          String          @default("pending")
  requested_by    String
  decided_by      String?
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  decided_at      DateTime?       @db.Timestamptz(6)
  custom_entities custom_entities @relation(fields: [entity_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants         tenants         @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vaults          vaults          @relation(fields: [vault_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("control")
}

model custom_entity_tests {
  id                String          @id
  entity_id         String
  sample_ciphertext Bytes
  sample_nonce      Bytes
  dek_id            String
  expect_match      Boolean
  created_by        String
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  custom_entities   custom_entities @relation(fields: [entity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([entity_id], map: "custom_entity_tests_entity")
  @@schema("control")
}

model custom_entity_uploads {
  id              String          @id
  entity_id       String
  ciphertext      Bytes
  nonce           Bytes
  dek_id          String
  expires_at      DateTime        @db.Timestamptz(6)
  custom_entities custom_entities @relation(fields: [entity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("control")
}

model custom_entity_values {
  entity_id         String
  list_version      Int
  index_key_version Int             @default(1)
  value_hmac        Bytes
  custom_entities   custom_entities @relation(fields: [entity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([entity_id, list_version, value_hmac])
  @@schema("control")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model custom_entity_versions {
  entity_id       String
  version         Int
  snapshot        Json
  published_by    String
  approved_by     String
  published_at    DateTime        @default(now()) @db.Timestamptz(6)
  benchmark       Json?
  custom_entities custom_entities @relation(fields: [entity_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([entity_id, version])
  @@schema("control")
}

model ruleset_versions {
  vault_id String @id
  version  BigInt
  vaults   vaults @relation(fields: [vault_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("control")
}

model monitor_state {
  component  String   @id
  status     String
  failures   Int      @default(0)
  since      DateTime @default(now()) @db.Timestamptz(6)
  checked_at DateTime @default(now()) @db.Timestamptz(6)

  @@schema("control")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model webhook_deliveries {
  id                String            @id @db.Uuid
  endpoint_id       String
  tenant_id         String
  event_id          String
  event_type        String
  payload           Json
  status            String            @default("pending")
  attempts          Int               @default(0)
  next_attempt_at   DateTime          @default(now()) @db.Timestamptz(6)
  last_status       Int?
  last_error        String?
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  delivered_at      DateTime?         @db.Timestamptz(6)
  webhook_endpoints webhook_endpoints @relation(fields: [endpoint_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([endpoint_id, event_id])
  @@index([created_at], map: "webhook_deliveries_age")
  @@index([next_attempt_at], map: "webhook_deliveries_due", where: raw("(status = 'pending'::text)"))
  @@index([endpoint_id, created_at(sort: Desc)], map: "webhook_deliveries_recent")
  @@schema("control")
}

