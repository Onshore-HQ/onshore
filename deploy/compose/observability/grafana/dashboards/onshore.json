{
  "uid": "onshore-overview",
  "title": "Onshore: logs and health",
  "tags": [
    "onshore"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "onshore-loki"
        },
        "query": {
          "label": "service",
          "type": 1,
          "refId": "svc"
        },
        "definition": "label_values(service)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "error,warn,info",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "search",
        "label": "Search (request ID or text)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Log lines, last hour",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "onshore-loki"
          },
          "expr": "sum(count_over_time({service=~\"$service\"} [1h]))",
          "queryType": "instant"
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "onshore-loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errors, last hour",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "onshore-loki"
          },
          "expr": "sum(count_over_time({service=~\"$service\", level=\"error\"} [1h])) or vector(0)",
          "queryType": "instant"
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "onshore-loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Services up",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "onshore-prometheus"
          },
          "expr": "sum(rv_component_up)"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "onshore-prometheus"
      },
      "description": "From Onshore's own health checks. Needs RV_METRICS_KEY in .env.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "noValue": "Needs RV_METRICS_KEY"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Open alerts",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "onshore-prometheus"
          },
          "expr": "rv_open_alerts"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "onshore-prometheus"
      },
      "description": "Alerts nobody has acknowledged in the console. Needs RV_METRICS_KEY.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "noValue": "Needs RV_METRICS_KEY"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Errors by service",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "onshore-loki"
          },
          "expr": "sum by (service) (count_over_time({service=~\"$service\", level=\"error\"} [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{service}}"
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "onshore-loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Log lines by service",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "onshore-loki"
          },
          "expr": "sum by (service) (count_over_time({service=~\"$service\"} [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{service}}"
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "onshore-loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Vault response time (tokenize and detokenize)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "onshore-prometheus"
          },
          "expr": "rv_vault_latency_p50_ms",
          "legendFormat": "median"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "onshore-prometheus"
          },
          "expr": "rv_vault_latency_p95_ms",
          "legendFormat": "95th percentile"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "onshore-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "noValue": "Needs RV_METRICS_KEY"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "From Onshore's metrics endpoint. Set RV_METRICS_KEY in .env (Health & alerts, Metrics, Create key) and restart prometheus."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Audited operations, last hour",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "onshore-prometheus"
          },
          "expr": "sum by (action) (rv_audit_events_last_hour)",
          "legendFormat": "{{action}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "onshore-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "noValue": "Needs RV_METRICS_KEY"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "From Onshore's metrics endpoint. Set RV_METRICS_KEY in .env (Health & alerts, Metrics, Create key) and restart prometheus."
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Slow control API requests (over 1 second)",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "onshore-loki"
          },
          "expr": "{service=\"control-api\"} | json | ms > 1000 | line_format \"{{.method}} {{.route}} {{.status}} {{.ms}} ms\"",
          "queryType": "range"
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "onshore-loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Control API requests that took over a second. Empty is good."
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Logs (filter by service, level and text such as a request ID)",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "onshore-loki"
          },
          "expr": "{service=~\"$service\", level=~\"$level\"} |= \"$search\"",
          "queryType": "range"
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "onshore-loki"
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}